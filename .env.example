# deckhandAI — environment variables
# Copy this file to .env.local and fill in your values.

# ── Required ─────────────────────────────────────────────────────────────────

# GitHub personal access token with `repo` scope (read + write the data repo)
GITHUB_TOKEN=ghp_your_token_here

# Private GitHub repo that stores your data files (owner/repo format)
# This repo should contain data/jobs.json and data/config.json
GITHUB_DATA_REPO=your-username/your-data-repo

# Password to log in to the deckhandAI dashboard
APP_PASSWORD=change-me

# Random 32+ character string for signing session cookies
# Generate one: openssl rand -base64 32
COOKIE_SECRET=change-me-to-a-random-32-char-string

# ── Optional ─────────────────────────────────────────────────────────────────

# Branch to read/write in the data repo (default: main)
# GITHUB_DATA_BRANCH=main

# AI generation (BYOM — bring your own model)
# AI_PROVIDER, AI_MODEL and AI_BASE_URL override Settings → Model. When one is
# set here, Settings shows it read-only. Leave them unset to manage the
# provider and model from the Settings page instead.
# AI_PROVIDER=anthropic       # anthropic | openai | ollama | custom
# AI_MODEL=                   # e.g. claude-haiku-5-5
# AI_BASE_URL=                # Ollama or custom OpenAI-compatible endpoint
# AI_API_KEY=                 # Not needed for Ollama

# Brave Search API key — used by the weekly job search script and by
# "Evaluate a job" as a fallback to find a fetchable cross-post when a URL
# can't be fetched directly (e.g. Workday). Skipped silently if unset.
# BRAVE_SEARCH_API_KEY=

# Set to "true" to enable demo mode — bypasses auth, disables the scraper, and
# reads/writes GITHUB_DATA_REPO directly. Point GITHUB_DATA_REPO at a public
# sample-data repo (see scripts/init-sample-repo.mjs) for a shareable demo.
# DEMO_MODE=false
# NEXT_PUBLIC_DEMO_MODE=false

# ── Storage backend ──────────────────────────────────────────────────────────

# Where jobs, config, profile and scrape targets live: "github" (default, the
# private data repo above) or "supabase". Anything else fails at startup.
# DATA_BACKEND=github

# Required only when DATA_BACKEND=supabase. The service-role key bypasses
# row-level security, so keep it server-side only — never NEXT_PUBLIC_.
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
